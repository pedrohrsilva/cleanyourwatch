      "packages": [
        {
          "package_name": "com.mobvoi.wear.privacy.aw",
          "display_name": "Mobvoi Telemetry & Privacy",
          "safety": "recommended",
          "description": "Collects and uploads Mobvoi usage telemetry and diagnostics in the background.",
          "memory_impact": "medium",
          "battery_impact": "medium"
        },
        {
          "package_name": "com.mobvoi.wear.account.aw",
          "display_name": "Mobvoi Cloud Account Sync",
          "safety": "recommended",
          "description": "Mobvoi account background sync service. Not required if you use Google Fit instead of Mobvoi Health.",
          "memory_impact": "medium",
          "battery_impact": "medium"
        },
        {
          "package_name": "com.mobvoi.wear.appsservice",
          "display_name": "Mobvoi Apps Promo Service",
          "safety": "recommended",
          "description": "Background promotional app recommendation service from Mobvoi.",
          "memory_impact": "low",
          "battery_impact": "low"
        },
        {
          "package_name": "com.hc.psyService",
          "display_name": "Factory Hardware Test Daemon",
