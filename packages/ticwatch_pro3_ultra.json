          "description": "Phone wallpaper backup transport stub leftover from AOSP.",
          "memory_impact": "low",
          "battery_impact": "low"
        },
        {
          "package_name": "com.google.android.wearable.setupwizard",
          "display_name": "Wear OS Setup Wizard",
          "safety": "recommended",
          "description": "Out-of-box initial pairing wizard; no longer needed once the watch is paired.",
          "memory_impact": "low",
          "battery_impact": "low"
        }
      ]
