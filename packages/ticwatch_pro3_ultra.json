          "description": "Manufacturing QA and hardware test service left over from factory firmware.",
          "memory_impact": "low",
          "battery_impact": "low"
        },
        {
          "package_name": "com.google.android.apps.wearable.retailattractloop",
          "display_name": "Retail Attract Loop Demo",
