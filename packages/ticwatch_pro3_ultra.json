          "description": "Partner configuration stub for pre-installing promotional apps during initial setup.",
          "memory_impact": "low",
          "battery_impact": "low"
        },
        {
          "package_name": "com.android.providers.userdictionary",
          "display_name": "User Dictionary Provider",
          "safety": "recommended",
          "description": "Legacy Android keyboard user dictionary provider unused on Wear OS.",
